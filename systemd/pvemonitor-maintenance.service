[Unit]
Description=PVEmonitor database maintenance (WAL checkpoint, optimize)
After=pvemonitor-api.service

[Service]
Type=oneshot
RemainAfterExit=no
Environment=PVEMONITOR_HOME=@@PVEMONITOR_HOME@@
ExecStart=@@PVEMONITOR_HOME@@/scripts/maintenance.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
